# Canonical origin. Used for CORS, origin checks and Stripe redirects.
APP_ORIGIN=http://localhost:3111

# Peppers every token hash. REQUIRED in production; a git-ignored secret is
# generated under DATA_DIR when this is unset in development.
# APP_SECRET=

# Where SQLite and private uploads live.
DATA_DIR=./data

# Stripe (server only). Leave unset in development to activate plans locally.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_PLUS=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Comma-separated allowlist. Matching accounts become admins (still need TOTP).
# ADMIN_EMAILS=you@example.com

# Development only: echo the 4-digit device code to the local UI.
# DEV_SHOW_DEVICE_CODE=true
